POSTGRES_DB=swcp
POSTGRES_USER=swcp
POSTGRES_PASSWORD=replace-with-a-local-password

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password

SEED_DEVELOPMENT_USERS=true
DEV_TEACHER_USERNAME=teacher
DEV_TEACHER_PASSWORD=replace-with-a-strong-local-password

POSTGRES_PORT=5432
API_PORT=5170
PGADMIN_PORT=5050
FRONTEND_PORT=5174

# Optional: comma-separated additional origins for api-gateway CORS (e.g. Tailscale or custom domain)
ADDITIONAL_CORS_ORIGINS=

AzureAIFoundry__Models__Gpt4o__Endpoint=https://swcp-resource.services.ai.azure.com/
AzureAIFoundry__Models__Gpt4o__ApiKey=
AzureAIFoundry__Models__Gpt6Sol__Endpoint=https://swcp-resource.services.ai.azure.com/
AzureAIFoundry__Models__Gpt6Sol__ApiKey=

# Only relevant if running a local LLM instance
LLM_MODEL_PATH=Qwen2.5-Coder-1.5B-Instruct-AWQ
LLM_MODEL_NAME=qwen2.5-coder-1.5b-instruct-awq
LOCAL_LLM_PORT=8080
VLLM_QUANTIZATION=awq_marlin       # maybe not valid for older hardware
VLLM_KV_CACHE_DTYPE=auto           # fp8
VLLM_MAX_MODEL_LEN=8192            # to be tuned
VLLM_GPU_MEMORY_UTILIZATION=0.80   # to be tuned
VLLM_MAX_NUM_SEQS=4                # to be tuned
VLLM_OVERFLOW_THRESHOLD=4          # concurrent/queued requests on primary vLLM before spilling over to worker vLLM

# Multi-node k3s cluster setup (used by scripts/setup-host-prereqs.sh)
CLUSTER_ROLE=control-plane         # control-plane | worker
CLUSTER_NODE_NAME=                 # Kubernetes node name & Grafana/Loki 'node' label (defaults to OS hostname)
CLUSTER_IFACE=                     # e.g. enp4s0 or tailscale0 (optional)
CLUSTER_NODE_IP=                   # this machine's cluster IP (optional, auto-detected from CLUSTER_IFACE)
CONTROL_PLANE_IP=                  # required when CLUSTER_ROLE=worker
K3S_TOKEN=                         # /var/lib/rancher/k3s/server/node-token from control plane (required when CLUSTER_ROLE=worker)
GPU_NODES=                         # optional comma-separated node hostnames to label swcp.io/gpu=true (default: all cluster nodes)
GVISOR_NODES=                      # optional comma-separated node hostnames to label swcp.io/gvisor=true
WORKER_SSH_HOSTS=                  # optional comma-separated SSH targets (e.g. test@172.25.11.243) to stream built images to worker nodes
