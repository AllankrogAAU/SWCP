{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SWCP.CoreApi",
    "Audience": "SWCP.Client",
    "PublicKeyPath": "../coreApi/.keys/jwt-public.pem"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:5174"]
  },
  "ReverseProxy": {
    "Routes": {
      "coreApi": {
        "ClusterId": "coreApi",
        "Order": 100,
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "coreScalar": {
        "ClusterId": "coreApi",
        "Order": 100,
        "Match": { "Path": "/scalar/{**catch-all}" }
      },
      "coreOpenApi": {
        "ClusterId": "coreApi",
        "Order": 100,
        "Match": { "Path": "/openapi/{**catch-all}" }
      }
    },
    "Clusters": {
      "coreApi": {
        "Destinations": {
          "primary": { "Address": "http://localhost:8081/" }
        }
      }
    }
  }
}
