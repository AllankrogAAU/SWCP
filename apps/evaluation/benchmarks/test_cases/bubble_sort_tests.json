{
  "task_id": "bubble_sort_001",
  "tests": [
    {
      "name": "Reverse sorted array",
      "input": [5, 4, 3, 2, 1],
      "expected": [1, 2, 3, 4, 5]
    },
    {
      "name": "Already sorted array",
      "input": [1, 2, 3, 4, 5],
      "expected": [1, 2, 3, 4, 5]
    },
    {
      "name": "Array with duplicates",
      "input": [3, 1, 3, 2],
      "expected": [1, 2, 3, 3]
    },
    {
      "name": "Mixed values",
      "input": [7, 1, 9, 2, 5],
      "expected": [1, 2, 5, 7, 9]
    }
  ],
  "edge_cases": [
    {
      "name": "Empty array",
      "input": [],
      "expected": []
    },
    {
      "name": "Single element",
      "input": [42],
      "expected": [42]
    },
    {
      "name": "All elements equal",
      "input": [5, 5, 5, 5],
      "expected": [5, 5, 5, 5]
    },
    {
      "name": "Negative numbers",
      "input": [-3, -1, -10, -5],
      "expected": [-10, -5, -3, -1]
    }
  ]
}