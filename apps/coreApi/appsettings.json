{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalLlm": {
    "AzureFallbackThreshold": 0
  },
  "Jwt": {
    "Issuer": "SWCP.CoreApi",
    "Audience": "SWCP.Client",
    "ExpiryMinutes": 60,
    "KeyDirectory": ".keys"
  }
}