{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalLlm": {
    "RoutingMethod": "confidence_score",
    "AzureFallbackThreshold": 0,
    "EscalateDiagnosisConfidence": "uncertain,guessing",
    "EscalateRootCauseCategories": "pointer_memory"
  },
  "Jwt": {
    "Issuer": "SWCP.CoreApi",
    "Audience": "SWCP.Client",
    "ExpiryMinutes": 60,
    "KeyDirectory": ".keys"
  }
}